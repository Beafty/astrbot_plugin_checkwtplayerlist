{
    "api_url": {
        "description": "API地址",
        "type": "string",
        "default": "",
        "hint": "查询服务器地址"
    },
    "api_method": {
        "description": "请求方法",
        "type": "string",
        "default": "POST",
        "hint": "GET/POST/PUT/PATCH/DELETE"
    },
    "api_param": {
        "description": "房间号参数名",
        "type": "string",
        "default": "getroom",
        "hint": "例如 example.com 使用 getroom(example.com/?getroom=123456) 作为房间号参数"
    },
    "use_local_t2i": {
        "description": "启用本地文生图",
        "type": "bool",
        "default": false,
        "hint": "开启后使用本地文生图地址"
    },
    "local_t2i_url": {
        "description": "本地文生图地址",
        "type": "string",
        "default": "http://127.0.0.1:7778/text2img",
        "hint": "仅在启用本地文生图时使用"
    },
    "replay_api_url": {
        "description": "Replay API地址",
        "type": "string",
        "default": "http://127.0.0.1:25580",
        "hint": "Replay解析服务地址"
    },
    "replay_api_method": {
        "description": "Replay API请求方法",
        "type": "string",
        "default": "POST",
        "hint": "GET/POST"
    },
    "replay_use_proxy": {
        "description": "使用代理（实验性）",
        "type": "bool",
        "default": false,
        "hint": "通过代理下载回放文件以加速"
    },
    "debug": {
        "description": "调试选项",
        "type": "object",
        "items": {
            "save_json": {
                "description": "保存接口返回JSON到本地",
                "type": "bool",
                "default": false,
                "hint": "用于调试时保存原始返回数据"
            },
            "json_dir": {
                "description": "调试JSON保存目录",
                "type": "string",
                "default": "debug",
                "hint": "相对插件目录的保存路径"
            }
        }
    }
}